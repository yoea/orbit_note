# Quiet Orbit 环境变量模板
# 复制为 .env.local（开发）或服务器环境变量（生产），填写真实值

# PostgreSQL 连接串（生产库）
DATABASE_URL=postgres://user:password@localhost:5432/quiet_orbit

# WebAuthn RP 信息 —— 必须与实际访问域名完全一致！
# 生产：把下面三行换成 <裸域名> / https://<域名>，例如
#   WEBAUTHN_RP_ID=diary.example.com
#   WEBAUTHN_RP_NAME=Orbit
#   WEBAUTHN_ORIGIN=https://diary.example.com
# ⚠️ 生产上留成 localhost 的后果**不是**「登录报错」，而是**所有通行密钥被浏览器直接拒绝**
#    （The RP ID "localhost" is invalid for this domain）——进程健康、/login 200，看不出异常。
#    scripts/deploy.sh（前置）与 scripts/update.sh（运行期）都有硬校验会拦住这类配置。
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Orbit
WEBAUTHN_ORIGIN=http://localhost:3000

# 会话签名密钥（HS256）—— 至少 32 字符，生成：openssl rand -base64 48
SESSION_SECRET=please-generate-a-random-48-byte-secret

# 加密方案版本（当前为 1，未来升级加密方案时递增）
RECOVERY_KEY_VERSION=1

# 一键部署脚本参数（scripts/deploy.sh 从 .env.local 读取；不提交 git）
# REMOTE_HOST=myserver              # ~/.ssh/config 中的主机别名
# REMOTE_UPDATE=/path/to/update.sh  # 服务器端 update.sh 绝对路径

# 和风天气 API key（实时天气；客户端直调，NEXT_PUBLIC_ 前缀会注入前端）
NEXT_PUBLIC_QWEATHER_KEY=your-qweather-key

# 页脚版权名（构建时注入；可选，不配置则显示 Orbit）
NEXT_PUBLIC_COPYRIGHT_NAME=YourName
